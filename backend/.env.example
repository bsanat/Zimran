# Copy to .env and fill in. Never commit real secrets.

# --- Database (used by the Spring app) ---
DB_URL=jdbc:postgresql://localhost:5432/zimran_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Database (used by docker-compose.yml to create the Postgres container) ---
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=zimran_db
DATABASE_PORT=5432

# --- Google Gemini (free tier) ---
# Free key from https://aistudio.google.com/apikey. Put the real key in backend/.env or your run config, never here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Guest identity ---
GUEST_TOKEN_SECRET=
GUEST_TOKEN_TTL=7d

# --- Demo ---
# Full sandbox demo, including fictional sample events. Keep false for the real catalog.
DEMO_ENABLED=false
# Premium access without fictional events; manual alert checks may find no new events.
DEMO_PREMIUM_ENABLED=false

# --- Event catalog ingestion ---
EVENT_INGESTION_ENABLED=true
EVENT_INGESTION_CRON=0 */15 * * * *

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Pair Planning ---
PAIR_INVITE_TTL=48h
