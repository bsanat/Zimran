# Copy to .env and fill in. Never commit real secrets.

# --- Database (used by the Spring app) ---
# JDBC URL of the Postgres database
DB_URL=jdbc:postgresql://localhost:5432/zimran_db
# Database user / password for the app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Database (used by docker-compose.yml to create the Postgres container) ---
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=zimran_db
# Host port mapped to Postgres 5432
DATABASE_PORT=5432

# --- Ticketmaster Discovery API ---
# API key (consumer key). Blank = app boots, event search is unavailable.
TICKETMASTER_API_KEY=
# Base URL override (e.g. a WireMock stub); defaults to the public API
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

# --- OpenAI ---
# API key. Blank = app boots, AI ranking is unavailable.
OPENAI_API_KEY=
# Model used for ranking/explanations
OPENAI_MODEL=gpt-5-mini
# Base URL override (e.g. a WireMock stub); defaults to the public API
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web ---
# Comma-separated list of origins allowed to call /api/**
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Guest identity ---
# HMAC-SHA256 key for X-Guest-Token (at least 32 bytes). Blank = random per process, tokens die on restart.
GUEST_TOKEN_SECRET=
# Guest token lifetime (Spring duration, e.g. 7d)
GUEST_TOKEN_TTL=7d

# --- Demo ---
# true enables POST /api/demo/premium ("Try Premium Demo") and seeds fictional NYC sample events (isDemo)
DEMO_ENABLED=false

# --- Event catalog ingestion ---
# Scheduled ingestion of every supported city into the events table
EVENT_INGESTION_ENABLED=true
# Spring cron, 6 fields
EVENT_INGESTION_CRON=0 */15 * * * *

# --- Frontend ---
# Public frontend address; Pair invite links are built from it
FRONTEND_URL=http://localhost:3000

# --- Pair Planning ---
# How long a Pair invite stays open (Spring duration, e.g. 48h)
PAIR_INVITE_TTL=48h
