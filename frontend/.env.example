# SerpApi: серверный ключ. Уже заданный API_KEY в .env тоже поддерживается.
SERPAPI_KEY=
# Оставьте пустым для встроенного SerpApi. Задайте для внешнего Backend.
# Для отдельного Backend предпочтителен серверный proxy (без CORS).
API_PROXY_ORIGIN=
# Альтернатива: публичный адрес Backend, который разрешает CORS.
NEXT_PUBLIC_API_BASE_URL=
