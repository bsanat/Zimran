# SerpApi: серверный ключ. Уже заданный API_KEY в .env тоже поддерживается.
SERPAPI_KEY=
# Адрес Java backend, например http://localhost:8080. Пусто = каталог и планировщик работают на встроенном
# SerpApi, а AI-чат, Pair, Event Buddy, оповещения и Premium недоступны (им нужен backend).
# Предпочтительный способ: серверный proxy Next.js (без CORS, cookie языка доходит до backend).
API_PROXY_ORIGIN=
# Альтернатива: публичный адрес backend, который сам разрешает CORS для этого сайта
# (на backend: CORS_ALLOWED_ORIGINS=<адрес frontend>). Язык тогда передаётся заголовком Accept-Language.
NEXT_PUBLIC_API_BASE_URL=
